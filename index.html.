 const hg=S.hauls.map(h=>{const ss=S.sales.filter(s=>S.items.some(i=>i.haul===h.id&&i.id===s.item));return{g:h.name,n:ss.length,rev:sum(ss,s=>+s.price||0),pr:sum(ss,profit)}});
 const d=[];for(let i=29;i>=0;i--){const x=new Date();x.setDate(x.getDate()-i);d.push(x.toISOString().slice(0,10))}const vals=d.map(k=>sum(S.sales.filter(s=>s.date===k),s=>+s.price||0)),mx=Math.max(1,...vals);
 return`<h2 style="margin-bottom:10px">Statistik</h2><div class="grid">${kpi('Umsatz',eur(f.rev))}${kpi('Gewinn',eur(pr),pc(pr))}${kpi('Ausgaben',eur(f.exp))}${kpi('Verkäufe',ns)}${kpi('Lagerbestand',S.items.filter(avail).length+' · '+eur(f.stock))}${kpi('Ø Gewinn / Piece',ns?eur(pr/ns):'–',ns?pc(pr):'')}</div>
 ${ns?`<div class="card"><h3>Umsatz letzte 30 Tage</h3><div class="bar">${vals.map((v,i)=>`<i title="${dt(d[i])}: ${eur(v)}" style="height:${v/mx*100}%"></i>`).join('')}</div></div>${T('Marke',grp('brand'))}${T('Kategorie',grp('cat'))}${T('Haul',hg)}`:'<div class="card note">Noch nicht genügend Daten – Auswertungen erscheinen nach dem ersten Verkauf.</div>'}`}
function go(){if(!S.cfg)return $('#main').innerHTML='<p class="note">Lade Daten…</p>';
 $('#nav').innerHTML='<b>Resale Hub</b>'+pages.map(([k,n,ic])=>`<a class="${k===view?'on':''}" onclick="view='${k}';arg=null;go()"><i>${ic}</i>${n}</a>`).join('')+'<a onclick="logout()" style="margin-top:auto"><i>↪</i>Abmelden</a>';
 $('#brands').innerHTML=brands().map(b=>`<option value="${esc(b)}">`).join('');$('#allsizes').innerHTML=sizesAll.map(b=>`<option value="${b}">`).join('');
 const act=document.activeElement?.id;const P={hauls,items,sales,fin:finp,stats};
 try{$('#main').innerHTML=P[view]()}catch(e){$('#main').innerHTML='<div class="al">Fehler: '+esc(e.message)+'</div>'}
 const qs=$('#qs');if(qs){qs.oninput=()=>{q.s=qs.value;go()};if(act==='qs'){qs.focus();qs.setSelectionRange(99,99)}}}
(async()=>{const t=setTimeout(()=>{if(!db)$('#main').innerHTML='<div class="al">Supabase-Verbindung nicht verfügbar. Prüfe URL, Key, SQL-Tabelle und Internetverbindung.</div>'},10000);
 db=await claude.use('db');if(!db)return;clearTimeout(t);
 for(const n of[...N,'cfg']){col[n]=db.collection(n);col[n].onSnapshot(s=>{if(n==='cfg'){const c=s.docs.find(d=>d.id==='main')?.data();if(c)S.cfg=c;else if(!S.cfg){S.cfg={team:['Person 1','Person 2','Person 3'],plats:['Vinted','eBay Kleinanzeigen','Depop'],carriers:['DHL','DPD','Hermes','Sonstige'],locs:['Regal A','Box 01','Box 02','Kleiderstange B'],share:[33.33,33.33,33.34]};col.cfg.doc('main').get().then(g=>{if(!g.exists)col.cfg.doc('main').set(S.cfg)})}}else S[n]=s.docs.map(d=>d.data());if(!document.querySelector('.mod'))go()},e=>{$('#main').innerHTML='<div class="al">Datenfehler: '+esc(e.message)+'</div>'})}})();
