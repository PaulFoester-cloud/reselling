 ${rows.map((r,i)=>`<div class="pc"><img src="${r.thumb}"><div><textarea rows="1" data-i="${i}" data-n="1" placeholder="Notiz: Größe, Zustand, Mängel …">${esc(r.note)}</textarea><div class="f">${F.map(x=>fld(r,i,x)).join('')}</div>${r.err?`<div class="note neg">${esc(r.err)}</div>`:''}<button class="x d" data-a="rm" data-i="${i}" style="margin-top:4px">Entfernen</button></div></div>`).join('')}</div>`};
 m.oninput=m.onchange=e=>{const t=e.target,i=t.dataset.i;if(i==null)return;if(t.dataset.n)rows[i].note=t.value;else{rows[i].f[t.dataset.k]=t.value;t.classList.toggle('open',!t.value)}};
 m.onchange=async e=>{const t=e.target;if(t.dataset.a==='files'){const fs=[...t.files];msg='Fotos werden vorbereitet…';draw();for(const f of fs){try{const p=await photoProc(f);rows.push({...p,note:'',f:{brand:'',cat:'',size:'',color:'',cond:''}});msg='Fotos werden vorbereitet… ('+rows.length+'/'+fs.length+')';draw()}catch(x){}}msg='';draw();return}
  const i=t.dataset.i;if(i!=null&&!t.dataset.n){rows[i].f[t.dataset.k]=t.value;t.classList.toggle('open',!t.value)}};
 m.onclick=async e=>{const b=e.target.closest('button');if(!b)return;const a=b.dataset.a;
  if(a==='close'){if(rows.length&&!await ask('Nicht gespeicherte Fotos verwerfen?','Verwerfen'))return;return closeMod(m)}
  if(a==='rm'){rows.splice(b.dataset.i,1);draw()}
  if(a==='ai'){const sm=await claude.use('sample');if(!sm){msg='!KI ist hier nicht verfügbar. Öffne die Seite angemeldet über claude.ai. Du kannst die Felder von Hand ausfüllen.';return draw()}
   busy=true;msg='';let done=0;draw();
   for(const r of rows){if(r.done)continue;try{const o=await sm.json(`Du siehst ein Foto eines Second-Hand-Kleidungsstücks und eine kurze Notiz: „${r.note||'(keine)'}“.
Antworte NUR mit einem JSON-Objekt: {"brand":"","cat":"","size":"","color":"","cond":""}.
Regeln: Fülle ein Feld nur aus, wenn es auf dem Foto klar erkennbar oder in der Notiz genannt ist. Sonst "" (leer lassen). NICHT raten.
brand: nur bei lesbarem Logo/Etikett/Schriftzug oder in der Notiz. cat: genau einer aus ${JSON.stringify(CAT)}. color: genau einer aus ${JSON.stringify(COL)}. size: nur aus Notiz oder lesbarem Etikett (z. B. M, L, 32, 42). cond: genau einer aus ${JSON.stringify(COND)}, nur wenn die Notiz Hinweise zum Zustand gibt.`,{images:[r.blob],cache:false});
    const ok={cat:CAT,color:COL,cond:COND};for(const k of['brand','cat','size','color','cond']){let v=String(o?.[k]??'').trim();if(ok[k]&&!ok[k].includes(v))v='';if(v&&!r.f[k])r.f[k]=v}r.done=1;r.err='';done++;draw()}
    catch(x){r.err='Nicht erkannt: '+(x.message||x.code||'Fehler');if(['not_granted','rate_limited','capability_disabled'].includes(x.code)){msg='!'+(x.code==='not_granted'?'Zugriff auf KI nicht erlaubt.':'Zu viele Anfragen – bitte später erneut versuchen.');break}}}
   busy=false;if(!msg)msg=done?`${done} Foto(s) ausgewertet. Gelbe Felder sind offen – bitte prüfen.`:'';draw()}
  if(a==='save'){busy=true;draw();let n=0;const left=[];for(const r of rows){try{await addPiece({...r.f,photo:r.thumb,notes:r.note},haulId);n++}catch(x){left.push(r)}}rows=left;busy=false;msg=left.length?`!${left.length} nicht gespeichert – bleiben stehen.`:'';draw();toast(n+' Pieces gespeichert ✓');if(!left.length)closeMod(m)}};
 draw()}

