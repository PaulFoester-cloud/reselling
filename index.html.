<script>
// ================= SUPABASE-VERBINDUNG =================
// Trage hier die Project URL und den anon/public key aus Supabase ein.
// NIEMALS den service_role-Key in eine Website kopieren!
const SUPABASE_URL = 'HIER_DEINE_SUPABASE_PROJECT_URL_EINTRAGEN';
const SUPABASE_ANON_KEY = 'HIER_DEINEN_SUPABASE_ANON_PUBLIC_KEY_EINTRAGEN';
const sbClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
let __resolveDbReady;
window.__dbReady = new Promise(resolve => { __resolveDbReady = resolve; });
let resaleCurrentRole = null;

function showResaleLogin(message=''){
  const old=document.getElementById('rh-auth'); if(old) old.remove();
  const box=document.createElement('div'); box.id='rh-auth'; box.className='rh-auth';
  box.innerHTML=`<form id="rh-login-form">
    <h1>Resale Hub</h1>
    <p>Dieser Bereich ist nur für freigeschaltete Teammitglieder zugänglich.</p>
    <label>E-Mail</label><input name="email" type="email" autocomplete="username" required>
    <label>Passwort</label><input name="password" type="password" autocomplete="current-password" required>
    <div class="err" id="rh-login-error">${message}</div>
    <button type="submit">Anmelden</button>
    <p>Neue Konten werden ausschließlich vom Administrator angelegt und freigeschaltet. Eine öffentliche Registrierung gibt es nicht.</p>
  </form>`;
  document.body.appendChild(box);
  box.querySelector('form').onsubmit=async e=>{
    e.preventDefault();
    const f=new FormData(e.target), b=e.target.querySelector('button');
    const err=box.querySelector('#rh-login-error');
    b.disabled=true; b.textContent='Anmeldung…'; err.textContent='';
    const {data,error}=await sbClient.auth.signInWithPassword({email:f.get('email'),password:f.get('password')});
    if(error){err.textContent='Anmeldung fehlgeschlagen. Prüfe E-Mail und Passwort.';b.disabled=false;b.textContent='Anmelden';return;}
    await activateResaleSession(data.session,err,b);
  };
}

async function activateResaleSession(session,errorNode=null,button=null){
  if(!session?.user?.id){showResaleLogin();return false;}
  const {data:member,error}=await sbClient.from('team_members').select('role, enabled').eq('user_id',session.user.id).maybeSingle();
  if(error || !member || member.enabled !== true){
    await sbClient.auth.signOut();
    if(error) console.error('Teamprüfung fehlgeschlagen:',error);
    const message='Kein Zugriff: Dieses Konto wurde vom Administrator nicht für den Resale Hub freigeschaltet.';
    if(errorNode){errorNode.textContent=message;if(button){button.disabled=false;button.textContent='Anmelden';}}
    else showResaleLogin(message);
    return false;
  }
  resaleCurrentRole=member.role || 'member';
  document.getElementById('rh-auth')?.remove();
  __resolveDbReady();
  return true;
}

async function initResaleAuth(){
  if(SUPABASE_URL.startsWith('HIER_') || SUPABASE_ANON_KEY.startsWith('HIER_')){
    const e=document.createElement('div');e.className='rh-auth';e.innerHTML='<div style="background:white;padding:22px;border-radius:12px;max-width:460px"><h2>Supabase noch nicht eingerichtet</h2><p>Öffne index.html und trage oben SUPABASE_URL sowie SUPABASE_ANON_KEY ein. Danach die Datei erneut veröffentlichen.</p></div>';document.body.appendChild(e);return;
  }
  const {data:{session},error}=await sbClient.auth.getSession();
  if(error) console.error(error);
  if(session) await activateResaleSession(session); else showResaleLogin();
}function makeSupabaseDb(){
  return {collection:(collection)=>({
    onSnapshot:(callback,onError)=>{
      let stopped=false;
      const refresh=async()=>{const {data,error}=await sbClient.from('app_records').select('id,data').eq('collection',collection);if(error)throw error;if(!stopped)callback({docs:(data||[]).map(row=>({id:row.id,data:()=>row.data}))});};
      refresh().catch(e=>onError&&onError(e));
      const channel=sbClient.channel('resale-'+collection+'-'+Math.random().toString(36).slice(2))
        .on('postgres_changes',{event:'*',schema:'public',table:'app_records',filter:'collection=eq.'+collection},()=>refresh().catch(e=>onError&&onError(e))).subscribe();
      return ()=>{stopped=true;sbClient.removeChannel(channel)};
    },
    doc:(id)=>({
      set:async(value)=>{const {error}=await sbClient.from('app_records').upsert({collection,id,data:value},{onConflict:'collection,id'});if(error)throw error;},
      get:async()=>{const {data,error}=await sbClient.from('app_records').select('data').eq('collection',collection).eq('id',id).maybeSingle();if(error)throw error;return {exists:!!data,data:()=>data?.data};},
      delete:async()=>{const {error}=await sbClient.from('app_records').delete().eq('collection',collection).eq('id',id);if(error)throw error;}
    })
  })};
}
window.logout=async()=>{await sbClient.auth.signOut();location.reload();};
// Kompatibilitätsschicht für die ursprüngliche App:
// Datenbank -> Supabase, Downloads -> Browser. Die Claude-Bild-KI bleibt optional.
window.claude={use:async(name)=>{
  if(name==='db'){await window.__dbReady;return makeSupabaseDb();}
  if(name==='downloads')return {save:async({filename,data})=>{const url=URL.createObjectURL(data);const a=document.createElement('a');a.href=url;a.download=filename;a.click();setTimeout(()=>URL.revokeObjectURL(url),1500);}};
  if(name==='sample')return null;
  return null;
}};
initResaleAuth();
// ================= URSPRÜNGLICHE RESALE-HUB-APP =================
const $=s=>document.querySelector(s);
const eur=n=>(+n||0).toLocaleString('de-DE',{style:'currency',currency:'EUR'});
const dt=d=>d?new Date(d).toLocaleDateString('de-DE'):'–';
const today=()=>new Date().toISOString().slice(0,10);
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const N=['hauls','items','sales','tx'];
const S={hauls:[],items:[],sales:[],tx:[],cfg:null};
const ST=['Neu eingekauft','Wird kontrolliert','Fotografieren','Bereit zum Einstellen','Online','Reserviert','Verkauft','Verpackt','Versendet','Zurückgegeben'];
const HS=['Geplant','Bestellt','Unterwegs','Zugestellt','Kontrolliert','Abgeschlossen'];
const SH=['Noch nicht verpackt','Verpackt','Versandlabel erstellt','Abgegeben','Zugestellt','Problem'];
const CAT=['T-Shirt','Hoodie','Pullover','Sweatshirt','Jacke','Hose','Jeans','Shorts','Hemd','Schuhe','Accessoires','Sonstiges'];
const COL=['Schwarz','Weiß','Grau','Beige','Braun','Blau','Dunkelblau','Rot','Grün','Gelb','Orange','Rosa','Lila','Mehrfarbig','Sonstige'];
const COND=['Neu mit Etikett','Neu ohne Etikett','Sehr gut','Gut','Akzeptabel','Beschädigt'];
const BR=['Nike','Adidas','Ralph Lauren','Lacoste','Carhartt','Levi’s','Tommy Hilfiger','The North Face','Champion','Vintage / Unbranded','Sonstige'];
const TXT=['Ausgabe','Einnahme','Einzahlung','Entnahme','Rückerstattung'];
const LET=['XXS','XS','S','M','L','XL','XXL','XXXL','One Size'];
const brands=()=>[...new Set([...BR,...(S.cfg?.brands||[])])];
const pages=[['hauls','Hauls','▣'],['items','Artikel','☰'],['sales','Verkäufe','€'],['fin','Finanzen','◔'],['stats','Statistik','◢']];
let db,col={},view='hauls',arg=null;
const team=()=>S.cfg?.team||[];const memSel=()=>team().length?team():['–'];
const uid=p=>p+Date.now().toString(36)+Math.random().toString(36).slice(2,5);
const sum=(a,f)=>a.reduce((x,y)=>x+f(y),0);
function toast(t){const e=$('#toast');e.textContent=t;e.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(()=>e.style.display='none',2200)}
const closeMod=m=>{m.remove();go()};const endDlg=m=>{m.remove();if(!document.querySelector('.mod'))go()};
window.alert=msg=>{const m=document.createElement('div');m.className='mod';m.style.zIndex=60;m.innerHTML=`<div><p>${esc(msg)}</p><div class="row"><button class="p">OK</button></div></div>`;document.body.appendChild(m);m.querySelector('button').onclick=()=>endDlg(m)};
const ask=(msg,label='Löschen')=>new Promise(r=>{const m=document.createElement('div');m.className='mod';m.style.zIndex=60;m.innerHTML=`<div><p>${esc(msg)}</p><div class="row"><button class="p" id="y">${label}</button><button id="n">Abbrechen</button></div></div>`;document.body.appendChild(m);m.querySelector('#y').onclick=()=>{endDlg(m);r(true)};m.querySelector('#n').onclick=()=>{endDlg(m);r(false)}});
const save=async(n,o)=>{try{await col[n].doc(o.id).set(o);const c=await col[n].doc(o.id).get();if(!c.exists)throw new Error('Datensatz wurde nicht bestätigt')}catch(e){alert('NICHT gespeichert: '+e.message);throw e}};
const del=async(n,id)=>{try{await col[n].doc(id).delete()}catch(e){alert('Löschen fehlgeschlagen: '+e.message);throw e}};
// ---- Berechnungen
const hTotal=h=>(+h.price||0)+(+h.ship||0)+(+h.other||0);
function cost(it){if(it.manual)return +it.cost||0;const h=S.hauls.find(x=>x.id===it.haul);if(!h)return +it.cost||0;const its=S.items.filter(x=>x.haul===h.id),man=its.filter(x=>x.manual),rest=Math.max(+h.qty||0,its.length)-man.length;return rest>0?Math.max(0,hTotal(h)-sum(man,b=>+b.cost||0))/rest:0}
const profit=s=>(+s.price||0)-(+s.fee||0)-(+s.other||0)-(+s.cost||0);
const avail=i=>!i.archived&&!['Verkauft','Verpackt','Versendet','Zurückgegeben'].includes(i.status);
const nm=i=>i.name||((i.brand||'')+' '+(i.cat||'')).trim()||'Piece';
const missing=i=>['brand','cat','size','color','cond'].filter(k=>!String(i[k]||'').trim());
function fin(){const rev=sum(S.sales,s=>+s.price||0),purch=sum(S.hauls,hTotal),fees=sum(S.sales,s=>+s.fee||0),oth=sum(S.sales,s=>+s.other||0),ship=sum(S.sales,s=>+s.shipCost||0),cogs=sum(S.sales,s=>+s.cost||0);
 const t=k=>sum(S.tx.filter(x=>x.type===k),x=>+x.amt||0);const ops=t('Ausgabe'),inc=t('Einnahme'),dep=t('Einzahlung'),wd=t('Entnahme')+t('Rückerstattung');
 const exp=purch+fees+oth+ship+ops,income=rev+inc,net=income-(cogs+fees+oth+ship+ops);return{rev,purch,fees,oth,ship,ops,inc,dep,wd,exp,income,net,cash:dep+income-exp-wd,stock:sum(S.items.filter(avail),cost)}}
// ---- Speichern von Pieces
let lastNum=0;
async function nextId(){let n=Math.max(lastNum,...S.items.map(i=>parseInt(i.id.slice(3))||0))+1;for(;;n++){const id='RH-'+String(n).padStart(4,'0');if(!(await col.items.doc(id).get()).exists){lastNum=n;return id}}}
async function addPiece(p,haulId){const h=S.hauls.find(x=>x.id===haulId)||{};const id=await nextId();const c=p.cost===''||p.cost==null?'':+p.cost;
 const o={id,haul:haulId,brand:p.brand||'',cat:p.cat||'',size:p.size||'',color:p.color||'',cond:p.cond||'',cost:c,manual:c!=='',est:p.est||'',price:'',notes:p.notes||'',photo:p.photo||'',name:((p.brand||'')+' '+(p.cat||'')).trim(),status:'Neu eingekauft',date:h.date||today()};
 await save('items',o);if(!S.items.some(i=>i.id===id))S.items=[...S.items,o];
 if(p.brand&&!brands().includes(p.brand)){S.cfg={...S.cfg,brands:[...(S.cfg.brands||[]),p.brand]};col.cfg.doc('main').set(S.cfg)}return id}
const photoProc=f=>new Promise((res,rej)=>{const r=new FileReader();r.onerror=rej;r.onload=()=>{const im=new Image();im.onerror=rej;im.onload=()=>{const sc=(m)=>{const k=Math.min(1,m/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=im.width*k;c.height=im.height*k;c.getContext('2d').drawImage(im,0,0,c.width,c.height);return c};
 const big=sc(900),sm=sc(360);big.toBlob(b=>res({blob:b,thumb:sm.toDataURL('image/jpeg',.6)}),'image/jpeg',.75)};im.src=r.result};r.readAsDataURL(f)});
// ---- Maske
function form(title,fields,vals,ok,extra){const m=document.createElement('div');m.className='mod';
 m.innerHTML=`<form><h2>${title}</h2>${fields.map(([k,l,t,o])=>`<label>${l}</label>`+(t==='sel'?`<select name="${k}">${o.map(x=>{const[v,n]=Array.isArray(x)?x:[x,x];return`<option value="${esc(v)}" ${vals?.[k]==v?'selected':''}>${esc(n)}</option>`}).join('')}</select>`:t==='area'?`<textarea name="${k}" rows="2">${esc(vals?.[k])}</textarea>`:`<input name="${k}" type="${t==='number'||t==='date'?t:'text'}" ${t==='number'?'step="0.01" min="0" inputmode="decimal"':''} ${t==='brand'?'list="brands"':t==='size'?'list="allsizes"':''} value="${esc(vals?.[k]??'')}" ${o==='req'?'required':''}>`)).join('')}
 <div class="row" style="margin-top:14px"><button class="p">Speichern</button><button type="button" id="x">Abbrechen</button><span class="sp"></span>${(extra||[]).map((e,i)=>`<button type="button" class="x ${e[2]||''}" data-e="${i}">${e[0]}</button>`).join('')}</div></form>`;
 document.body.appendChild(m);m.querySelector('#x').onclick=()=>closeMod(m);
 m.querySelectorAll('[data-e]').forEach(b=>b.onclick=async()=>{if(await extra[b.dataset.e][1](m)!==false)closeMod(m)});
 m.querySelector('form').onsubmit=async e=>{e.preventDefault();const f=Object.fromEntries(new FormData(e.target));try{const r=await ok(f);if(r!==false){closeMod(m);toast('Gespeichert ✓')}}catch(x){toast('Fehler – nichts gespeichert')}}}
const sizesAll=['26','28','30','32','34','36','38','40','42','44','46','48',...LET];
function newHaul(h){form(h?'Haul bearbeiten':'Neuer Haul',[['name','Name','text','req'],['supplier','Lieferant'],['date','Bestelldatum','date'],['qty','Anzahl Pieces im Haul','number'],['unit','Preis pro Stück (€) – optional','number'],['price','Kaufpreis gesamt (€) – wird aus Anzahl × Stückpreis berechnet','number'],['ship','Versandkosten (€)','number'],['other','Sonstige Kosten (€)','number'],['status','Lieferstatus','sel',HS]],h||{date:today(),status:'Bestellt'},f=>{const q=+f.qty||0,u=+f.unit||0;if(q&&u)f.price=(q*u).toFixed(2);return save('hauls',{...(h||{id:uid('h')}),...f})});
 const m=document.body.lastElementChild,g=n=>m.querySelector('[name='+n+']');g('qty').step='1';
 m.addEventListener('input',e=>{const q=+g('qty').value,u=+g('unit').value,p=+g('price').value;if(e.target.name==='price'){if(q&&p)g('unit').value=(p/q).toFixed(2)}else if(q&&u)g('price').value=(q*u).toFixed(2);else if(q&&p&&!u)g('unit').value=(p/q).toFixed(2)})}
async function delHaul(id){const h=S.hauls.find(x=>x.id===id);if(!h)return;const its=S.items.filter(i=>i.haul===id),sold=its.filter(i=>S.sales.some(s=>s.item===i.id));
 if(sold.length)return alert('Dieser Haul enthält '+sold.length+' bereits verkaufte Pieces ('+sold.map(i=>i.id).join(', ')+'). Storniere zuerst die Verkäufe.');
 if(!await ask('Haul „'+h.name+'“'+(its.length?' mit '+its.length+' Pieces':'')+' endgültig löschen?'))return;
 try{for(const i of its)await del('items',i.id);await del('hauls',id);arg=null;toast('Haul gelöscht ✓');go()}catch(e){}}
function newPiece(haulId){form('Neues Piece',[['brand','Marke','brand'],['cat','Kategorie','sel',['',...CAT]],['size','Größe','size'],['color','Farbe','sel',['',...COL]],['cond','Zustand','sel',['',...COND]],['cost','Einkaufspreis (leer = automatisch)','number'],['est','Gesch. Verkaufspreis','number'],['notes','Notizen','area']],{},async f=>{await addPiece(f,haulId)})}// ---- Foto-KI-Erfassung
function photoAI(haulId){let rows=[],busy=false,msg='';const m=document.createElement('div');m.className='mod';document.body.appendChild(m);
