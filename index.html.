 const draw=()=>{m.innerHTML=`<div class="wide"><div class="row"><h2 class="sp">Fotos erfassen</h2><button data-a="close">Schließen</button></div>
 <p class="note">1. Fotos wählen (Etikett-Foto hilft). 2. Pro Foto kurz notieren, z. B. „L, gut, kleiner Fleck“. 3. „Mit Claude ausfüllen“. Gelbe Felder sind offen – nicht erkannt, nicht geraten.</p>
 <div class="row"><label class="tag" style="cursor:pointer;padding:7px 12px"><input type="file" accept="image/*" multiple hidden data-a="files">+ Fotos auswählen</label>${rows.length?`<button data-a="ai" ${busy?'disabled':''}>${busy?'Claude arbeitet…':'Mit Claude ausfüllen'}</button><button class="p" data-a="save" ${busy?'disabled':''}>Alle ${rows.length} speichern</button>`:''}</div>
